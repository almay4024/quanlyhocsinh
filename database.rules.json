{
  "rules": {
    ".read": false,
    ".write": false,
    "lopvui_cloud_v3": {
      ".read": "auth != null",
      ".write": "auth != null",
      "meta": {
        ".validate": "newData.hasChildren(['lastUpdatedAt']) && newData.child('lastUpdatedAt').isNumber() && (!newData.child('lastClientId').exists() || (newData.child('lastClientId').isString() && newData.child('lastClientId').val().length <= 80))",
        "keyTimestamps": {
          "$safeKey": {
            ".validate": "$safeKey.beginsWith('k_') && $safeKey.length === 18 && newData.isNumber()"
          }
        }
      },
      "kv": {
        "$safeKey": {
          ".validate": "$safeKey.beginsWith('k_') && $safeKey.length === 18 && (!newData.exists() || (newData.hasChildren(['updatedAt', 'clientId', 'encKey']) && newData.child('updatedAt').isNumber() && newData.child('clientId').isString() && newData.child('encKey').isString() && newData.child('encKey').val().beginsWith('lvenc_v38$') && (!newData.child('value').exists() || (newData.child('value').isString() && newData.child('value').val().beginsWith('lvenc_v38$') && newData.child('value').val().length <= 4500000))))"
        }
      },
      "deletedIds": {
        "$delId": {
          ".validate": "$delId.length <= 128 && newData.isNumber()"
        }
      },
      "cleanSlateV35": { ".validate": "newData.isBoolean()" },
      "encryptedV38": { ".validate": "newData.isBoolean()" },
      "lastFullPushAt": { ".validate": "newData.isNumber()" },
      "$other": {
        ".validate": false
      }
    },
    "lopvui_sync": {
      ".read": false,
      ".write": false
    }
  }
}